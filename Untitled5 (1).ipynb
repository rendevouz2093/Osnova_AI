          "text": [
            "P(H)=0.05 -> P(H|ALARM)=0.3214\n",
            "P(H)=0.2 -> P(H|ALARM)=0.6923\n",
            "P(H)=0.5 -> P(H|ALARM)=0.9000\n",
            "P(H)=0.8 -> P(H|ALARM)=0.9730\n"
          ]
        }
      ],
      "source": [
        "def bayes_update(p_h, p_alarm_h=0.90, p_alarm_s=0.10):\n",
        "    p_s = 1.0 - p_h\n",
        "    p_alarm = p_alarm_h * p_h + p_alarm_s * p_s\n",
        "    return (p_alarm_h * p_h) / p_alarm\n",
        "\n",
        "for p in [0.05, 0.20, 0.50, 0.80]:\n",
        "    print(f\"P(H)={p} -> P(H|ALARM)={bayes_update(p):.4f}\")"
      ]
    }
  ]
}